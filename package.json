{
  "name": "steakz-mis-prisma",
  "version": "1.0.0",
  "description": "Simple student MIS web portal for Steakz restaurant chain",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "db:push": "node -e \"const fs=require('fs');fs.mkdirSync('prisma',{recursive:true});fs.closeSync(fs.openSync('prisma/dev.db','a'))\" && prisma db push",
    "seed": "tsx src/lib/seed.ts",
    "setup": "prisma db push && tsx src/lib/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.2",
    "connect-flash": "^0.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "method-override": "^3.0.0",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-flash": "^0.0.40",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/method-override": "^0.0.35",
    "@types/node": "^24.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx src/lib/seed.ts"
  }
}
