extends layout

block content
  h1 Inventory
  p.page-intro Track stock levels and low stock items.

  if currentUser.role === "head_office" || currentUser.role === "manager"
    section.panel
      h2 Add Inventory Item
      form.form-row(action="/inventory", method="post")
        input(name="itemName", placeholder="Item name", required)
        if currentUser.role === "head_office"
          select(name="branchId")
            each branch in branches
              option(value=branch.id)= branch.name
        input(type="number", name="quantity", placeholder="Quantity", required)
        input(type="number", name="reorderLevel", placeholder="Reorder level", required)
        input(name="supplier", placeholder="Supplier", required)
        button(type="submit") Add

  section.panel
    h2 Inventory List
    table
      thead
        tr
          th Item
          th Branch
          th Quantity
          th Status
          th Reorder Level
          th Supplier
          th Actions
      tbody
        each item in items
          - const displayedQuantity = item.available ? item.quantity : 0
          tr(class=displayedQuantity === 0 ? "stock-out" : displayedQuantity <= item.reorderLevel ? "warning" : "")
            td= item.itemName
            td= item.branch
            td= displayedQuantity
            td
              if displayedQuantity === 0
                span.status-badge.status-cancelled Out of stock
              else if displayedQuantity <= item.reorderLevel
                span.status-badge.status-pending Low stock
              else
                span.status-badge.status-ready Available
            td= item.reorderLevel
            td= item.supplier
            td
              form.inline(action=`/inventory/${item.id}/use`, method="post")
                input.small-input(type="number", name="used", value="1", min="1")
                button.small(type="submit", disabled=displayedQuantity === 0) Use
              form.inline(action=`/inventory/${item.id}/add`, method="post")
                input.small-input(type="number", name="added", value="1", min="1")
                button.small(type="submit") Add Stock
              form.inline(action=`/inventory/${item.id}/set`, method="post")
                input.small-input(type="number", name="quantity", value=displayedQuantity, min="0")
                button.small(type="submit") Set
              form.inline(action=`/inventory/${item.id}/availability`, method="post")
                input(type="hidden", name="available", value=item.available ? "false" : "true")
                button.small(type="submit", disabled=!item.available && displayedQuantity === 0)= item.available ? "Mark Unavailable" : "Mark Available"
