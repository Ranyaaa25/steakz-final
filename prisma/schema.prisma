generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String
  branch    String?
  branchId  Int?
  branchRef Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  orders    Order[]
  reservations Reservation[]
  cartItems CartItem[]
  reviews   Review[]
}

model Branch {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  area        String
  address     String
  phone       String
  hours       String
  imageUrl    String
  gallery     String
  description String
  createdAt   DateTime @default(now())
  users       User[]
  orders      Order[]
  reservations Reservation[]
  inventory   Inventory[]
  cartItems   CartItem[]
  reviews     Review[]
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  description String   @default("")
  imageUrl    String   @default("")
  price       Float
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

model CartItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  menuItemId Int
  branchId   Int
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  branchRef  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId, branchId])
}

model Order {
  id        Int      @id @default(autoincrement())
  customer  String
  branch    String
  branchId  Int?
  status    String
  subtotal  Float    @default(0)
  serviceCharge Float @default(0)
  vat       Float    @default(0)
  total     Float
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  branchRef Branch?  @relation(fields: [branchId], references: [id])
  items     OrderItem[]
  reviews   Review[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  price      Float
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Inventory {
  id           Int      @id @default(autoincrement())
  itemName     String
  branch       String
  branchId     Int?
  quantity     Int
  reorderLevel Int
  supplier     String
  available    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  branchRef    Branch?  @relation(fields: [branchId], references: [id])
}

model Reservation {
  id        Int      @id @default(autoincrement())
  customer  String
  email     String
  phone     String
  branch    String
  branchId  Int?
  guests    Int
  date      String
  time      String
  notes     String   @default("")
  tableNumber String  @default("")
  status    String   @default("Requested")
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchRef Branch?  @relation(fields: [branchId], references: [id])
  reviews   Review[]
}

model Review {
  id            Int      @id @default(autoincrement())
  rating        Int
  comment       String
  customerId    Int
  branchId      Int
  orderId       Int?
  reservationId Int?
  createdAt     DateTime @default(now())
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchRef     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
}
